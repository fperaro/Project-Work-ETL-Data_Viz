      <aliases enabled='yes' />
      <column caption='Asst' datatype='string' name='[ASST]' role='dimension' type='nominal' />
      <column caption='Ospedali Posizione' datatype='spatial' name='[Calculation_0554934647525381]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT([LATITUDINE], [LONGITUDINE])' />
      </column>
      <column caption='Cont struttura per comune' datatype='integer' name='[Calculation_0554934652264454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Comune] : COUNT([Comune]) }' />
      </column>
      <column caption='cerchio dim' datatype='real' name='[Calculation_0554934658109448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SQRT([N_Ospedali_Comune])' />
      </column>
      <column caption='Anziani aree specialistiche ' datatype='boolean' name='[Calculation_0554934691000333]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([aree_specialistiche], &quot;GERIATRIA&quot;) OR CONTAINS([aree_specialistiche], &quot;LUNGODEGENZA&quot;) OR CONTAINS([aree_specialistiche], &quot;RIABILITAZIONE NEUROLOGICA&quot;) OR CONTAINS([aree_specialistiche], &quot;RIABILITAZIONE CARDIO&quot;)' />
      </column>
      <column caption='Ha pediatria ' datatype='boolean' name='[Calculation_0554934693552142]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([aree_specialistiche], &quot;PEDIATRIA&quot;) OR CONTAINS([aree_specialistiche], &quot;NEONATOLOGIA&quot;) OR CONTAINS([aree_specialistiche], &quot;NEUROPSICHIATRIA INFANTILE&quot;) OR CONTAINS([aree_specialistiche], &quot;TERAPIA INTENSIVA NEONATALE&quot;) OR CONTAINS([aree_specialistiche], &quot;CHIRURGIA PEDIATRICA&quot;)' />
