    <worksheet name='Numero di Ospedali per comune vs numero abitanti per comune'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Ospedali con differenza colore per quanti sono nel comune
</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AuraMed' name='federated.10jk0wz0ur03w517e2exn11ydx81' />
            <datasource caption='micuro_pulito' name='federated.1vly7id1n1ywrr190nvu91j7bd10' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.10jk0wz0ur03w517e2exn11ydx81'>
            <column caption='Cod Reg' datatype='integer' name='[COD_REG]' role='measure' type='quantitative' />
            <column caption='Log Abitanti Comuni' datatype='real' name='[Calculation_0554934631931904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOG(SUM([Totale]))' />
            </column>
            <column caption='Comune (residenti lombardia per fascia.csv)' datatype='string' name='[Comune (residenti_lombardia_per_fascia.csv)]' role='dimension' semantic-role='' type='nominal' />
            <column caption='Geometria' datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column datatype='integer' name='[Totale]' role='measure' type='quantitative' />
            <column-instance column='[Geometry]' derivation='Collect' name='[clct:Geometry:nk]' pivot='key' type='nominal' />
            <column-instance column='[COD_REG]' derivation='None' name='[none:COD_REG:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Comune (residenti_lombardia_per_fascia.csv)]' derivation='None' name='[none:Comune (residenti_lombardia_per_fascia.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[Totale]' derivation='Sum' name='[sum:Totale:qk]' pivot='key' type='quantitative' />
